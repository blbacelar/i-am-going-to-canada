# Public Supabase project identifier. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase credential used by the signed Calendly webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Calendly server-side integration
CALENDLY_PAT_TOKEN=your-calendly-pat
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-webhook-signing-key

# Server-only Dropbox Sign credentials
DROPBOX_SIGN_API_KEY=your-dropbox-sign-api-key
DROPBOX_SIGN_CLIENT_ID=your-dropbox-sign-client-id
