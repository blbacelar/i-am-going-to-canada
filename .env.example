# Public Supabase project identifier. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase credential used by the signed Calendly webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Calendly server-side integration
CALENDLY_PAT_TOKEN=your-calendly-pat
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-webhook-signing-key
CALENDLY_TEST_EVENT_TYPE_URI=https://api.calendly.com/event_types/your-test-event-id
CALENDLY_TEST_EVENT_URL=https://calendly.com/your-account/your-test-event
NEXT_PUBLIC_CALENDLY_TEST_EVENT_URL=

# Server-only SignWell credentials
SIGNWELL_API_KEY=your-signwell-api-key
SIGNWELL_TEST_MODE=true
SIGNWELL_TEST_RECIPIENT=
SIGNWELL_WEBHOOK_ID=your-signwell-webhook-id

# Test-only booking flow (never enable in production)
ENABLE_MOCK_BOOKING_FLOW=false
NEXT_PUBLIC_ENABLE_MOCK_BOOKING_FLOW=false
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Your Team <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=
DROPBOX_ACCESS_TOKEN=your-dropbox-oauth-access-token
DROPBOX_CONTRACTS_PATH=/Marina Snyder RCIC/Signed Contracts
INITIAL_QUESTIONNAIRE_URL=https://example.com/questionnaire
MOCK_CONSULTANT_NAME=TODO_CONTENT
MOCK_CONSULTANT_RCIC=TODO_CONTENT
MOCK_CONSULTANT_CONTACT=TODO_CONTENT
MOCK_CONSULTATION_FEE=TEST — no charge
